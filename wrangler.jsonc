// Configuración de Cloudflare (ver DESPLIEGUE.md). Todo lo que usa la app cabe en el plan gratuito.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excapp",
  "main": "worker.ts",
  // `wrangler deploy` construye la app antes de publicar (también en la compilación automática de Cloudflare).
  "build": { "command": "node scripts/cf-build.mjs", "watch_dir": "src" },
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // sin el envoltorio `__name` de esbuild: una función que una página convierte en <script> lo llamaría en el navegador
  "keep_names": false,
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  // Base de datos. `database_id`: el que devuelve `npx wrangler d1 create excapp` (ver DESPLIEGUE.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excapp",
      "database_id": "10be2b5e-0e25-417e-8500-2c835e6c4ca2",
      "migrations_dir": "drizzle",
    },
  ],
  // Lectura de fotos con IA (cupo diario gratuito).
  "ai": { "binding": "AI" },
  // Aviso diario a la oficina a las 6:15 UTC (7:15 / 8:15 en Madrid).
  "triggers": { "crons": ["15 6 * * *"] },
  "observability": { "enabled": true },
}
