{
  "name": "excapp",
  "version": "0.0.0",
  "private": true,
  "description": "Albaranes y fichajes de conductores (Next.js en Cloudflare Workers)",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/stop-dev.mjs",
    "dev": "wrangler d1 migrations apply excapp --local && NEXT_TELEMETRY_DISABLED=1 next dev -p ${PORT:-3100}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "build:cf": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "preview": "npm run build:cf && wrangler d1 migrations apply excapp --local && wrangler dev",
    "deploy": "npm run build:cf && wrangler d1 migrations apply excapp --remote && wrangler deploy",
    "check-types-errors": "tsc --noEmit",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "wrangler d1 migrations apply excapp --remote",
    "db:migrate:local": "wrangler d1 migrations apply excapp --local",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "@eslint/js": "10.0.1",
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "miniflare": "5.20261101.0-beta",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "source-map-js": "1.2.2"
  },
  "prettier": {
    "printWidth": 110,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
